{
  "specVersion": "0.1",
  "id": "client-download/legacy-natives-osx",
  "area": "client-download",
  "description": "legacy natives：按平台取 classifier；无 downloads 的库回退 Maven 路径",
  "given": {
    "operation": "planClientDownload",
