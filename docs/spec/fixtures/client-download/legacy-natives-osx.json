        "sha1": "0000000000000000000000000000000000000020",
        "size": 20
      },
      {
        "url": "https://libraries.minecraft.net/org/example/nomaven/2.0/nomaven-2.0.jar",
        "path": "/tmp/orzmc-fixture/versions/1.16.5/client/libraries/org/example/nomaven/2.0/nomaven-2.0.jar",
        "sha1": null,
        "size": null
      }
    ]
