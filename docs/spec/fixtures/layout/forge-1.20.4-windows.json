{
  "specVersion": "0.1",
  "id": "layout/forge-1.20.4-windows",
  "area": "layout",
  "description": "forge 服务端在 Windows 下的规范路径（forge-<v>.jar / java.exe）",
  "given": {
    "operation": "planLayout",
    "root": "/tmp/orzmc",
    "version": "1.20.4",
    "type": "forge",
    "javaMajor": 17,
    "platform": { "os": "windows", "arch": "x86_64" }
  },
  "expect": {
    "serverDir": "/tmp/orzmc/versions/1.20.4/server/forge",
    "serverJarName": "forge-1.20.4.jar",
    "serverJarPath": "/tmp/orzmc/versions/1.20.4/server/forge/forge-1.20.4.jar",
    "javaExecutable": "/tmp/orzmc/java/17/bin/java.exe"
  }
}
